<?xml version="1.0" encoding="utf-8"?>
<!--
  Day Arc — "curved earth"

  Design rules this file obeys, in order of importance:

    1. No straight edges. Every boundary on the dial is either an arc
       concentric with the display or a gradient with no edge at all.
       The horizon is the limb of a planet, not a chord.

    2. The sun orbits once per 24h. Wear OS exposes no sunrise/sunset
       data source, so the sun's position is driven purely by the clock:
       midnight at the bottom (hidden behind the earth), noon at the top,
       sunrise at 9 o'clock, sunset at 3 o'clock.

    3. The sky is lit from wherever the sun is. Rather than interpolating
       colours by time of day, the sky gradient lives inside the same
       rotating group as the sun, so its warm end always points at the
       sun. At night the warm end is buried behind the ground ellipse and
       only the deep blue end is visible. One rotation drives everything.

    4. Ambient is a separate drawing, not a dimmed one. Dimming a filled
       sun still leaves a filled disc, which is the wrong shape and the
       wrong power budget. So the always-on face has its own elements:
       an outlined sun, a hairline horizon, thin numerals, pure black
       everywhere else. WFF's Variant only knows AMBIENT, so ambient-only
       parts sit at alpha="0" and are raised to 255 by their Variant,
       while interactive-only parts do the reverse.

       Roughly 3% of the disc is lit in ambient. Black is genuinely off
       on this display, which is also why the ambient earth is filled
       solid black rather than hidden — it costs nothing and it occludes
       the sun once it drops below the horizon.

  Canvas is 450x450. Safe zone is r=198 from centre (0.88 of the radius);
  nothing readable crosses it.

  Validated against the official WFF v1 XSD — see tools/validate.sh.
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">

    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:09:00" />

    <Scene backgroundColor="#000000">

        <!--
          ================= SKY + SUN =================
          One group, one rotation. angle = seconds/240 + 180
            360 degrees / 86400 seconds = 1/240
            +180 puts midnight at the bottom of the dial.
        -->
        <Group name="sky_and_sun" x="0" y="0" width="450" height="450"
               pivotX="0.5" pivotY="0.5">

            <!-- One rotation, shared by every version of the sun. The group
                 itself stays visible in ambient; its children decide. -->
            <Transform target="angle" value="([SECONDS_IN_DAY] / 240) + 180" />

            <!-- The atmosphere. Warm end at local top, i.e. at the sun. -->
            <PartDraw name="sky" x="0" y="0" width="450" height="450">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Ellipse x="0" y="0" width="450" height="450">
                    <Fill color="#5081B4">
                        <LinearGradient
                            startX="225" startY="0" endX="225" endY="450"
                            colors="#FFF3D2 #FFD79B #E5A57C #A8C0D6 #5081B4 #1F3D68 #08152C"
                            positions="0.0 0.07 0.15 0.28 0.48 0.72 1.0" />
                    </Fill>
                </Ellipse>
            </PartDraw>

            <!--
              The sun, drawn at the local top of the group so the rotation
              above carries it around the dial. Orbit radius = 225 - 52 = 173.
              Glow is four stacked ARGB fills rather than a radial gradient —
              fewer moving parts, identical result at this size.
            -->
            <PartDraw name="sun" x="0" y="0" width="450" height="450">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Ellipse x="163" y="-10" width="124" height="124">
                    <Fill color="#1EFFD08A" />
                </Ellipse>
                <Ellipse x="181" y="8" width="88" height="88">
                    <Fill color="#30FFD89B" />
                </Ellipse>
                <Ellipse x="195" y="22" width="60" height="60">
                    <Fill color="#4DFFE3B4" />
                </Ellipse>
                <Ellipse x="206" y="33" width="38" height="38">
                    <Fill color="#FFFFF4D2" />
                </Ellipse>
            </PartDraw>

            <!--
              Ambient sun: the same disc, drawn as a ring instead of a fill.
              Same centre and radius as the interactive one, so it doesn't
              jump when the screen wakes. Invisible until AMBIENT raises it.
            -->
            <PartDraw name="sun_ambient" x="0" y="0" width="450" height="450"
                      alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255" />
                <Ellipse x="206" y="33" width="38" height="38">
                    <Stroke color="#FFE0CFA8" thickness="3" />
                </Ellipse>
            </PartDraw>

        </Group>

        <!--
          ================= SUN TRACK =================
          Static. Runs from sunrise at 9 o'clock (270) clockwise over the
          top to sunset at 3 o'clock (90). Same radius as the sun's orbit.
        -->
        <PartDraw name="track" x="0" y="0" width="450" height="450">
            <!-- Stroke is already 20% white, so this lands at ~12% in
                 ambient. Part alpha multiplies the stroke's own alpha. -->
            <Variant mode="AMBIENT" target="alpha" value="150" />
            <Arc centerX="225" centerY="225" width="346" height="346"
                 startAngle="270" endAngle="90" direction="CLOCKWISE">
                <Stroke color="#33FFFFFF" thickness="2" cap="ROUND"
                        dashIntervals="3 9" />
            </Arc>
        </PartDraw>

        <!--
          ================= THE EARTH =================
          A very large ellipse whose top arc becomes the horizon. Centre sits
          far below the dial so only a gentle planetary curve is visible:
            apex   (225, 292)
            edges  (0, 345) and (450, 345)
          Solved from those three points: rx=600, ry=727, centre (225, 1019),
          giving the bounding box below.
        -->
        <PartDraw name="earth" x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Ellipse x="-375" y="292" width="1200" height="1454">
                <Fill color="#0F1017">
                    <LinearGradient
                        startX="225" startY="292" endX="225" endY="450"
                        colors="#261E15 #0F1017 #070910"
                        positions="0.0 0.55 1.0" />
                </Fill>
            </Ellipse>
        </PartDraw>

        <!--
          The same planet in ambient, filled pure black. On OLED those pixels
          are off, so this is free — and it still occludes the sun ring once
          the sun drops below the horizon, which a hidden earth would not.
        -->
        <PartDraw name="earth_ambient" x="0" y="0" width="450" height="450"
                  alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <Ellipse x="-375" y="292" width="1200" height="1454">
                <Fill color="#FF000000" />
            </Ellipse>
        </PartDraw>

        <!-- Horizon. The one landscape cue that survives into ambient. -->
        <PartDraw name="horizon" x="0" y="0" width="450" height="450">
            <!-- Stroke alpha is 55%, so this lands at ~43% in ambient. -->
            <Variant mode="AMBIENT" target="alpha" value="200" />
            <Ellipse x="-375" y="292" width="1200" height="1454">
                <Stroke color="#8CFFD9A0" thickness="2" />
            </Ellipse>
        </PartDraw>

        <!--
          ================= TIME =================
          Sits in the sky, not in a band cut out of it.
        -->
        <PartText name="time" x="0" y="140" width="450" height="86">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="70" weight="LIGHT" color="#FFFFFF">
                    <Template><![CDATA[%s:%s]]>
                        <Parameter expression="[HOUR_0_23_Z]" />
                        <Parameter expression="[MINUTE_Z]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!--
          Ambient time. Same box, same size, so the numerals stay put when the
          screen wakes — only the stroke thins and the white cools. THIN at
          this size is most of the ambient pixel budget on its own.
        -->
        <PartText name="time_ambient" x="0" y="140" width="450" height="86"
                  alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="70" weight="THIN" color="#FFB8C0CA">
                    <Template><![CDATA[%s:%s]]>
                        <Parameter expression="[HOUR_0_23_Z]" />
                        <Parameter expression="[MINUTE_Z]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- Date, directly beneath. -->
        <PartText name="date" x="0" y="228" width="450" height="26">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="14" color="#9EFFFFFF">
                    <Template><![CDATA[%s %d %s]]>
                        <Parameter expression="[DAY_OF_WEEK_S]" />
                        <Parameter expression="[DAY]" />
                        <Parameter expression="[MONTH_S]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!--
          ================= COMPLICATIONS =================
          Two user-configurable slots on mirrored flank arcs, both at r=186
          (width/height 372) and 34 degrees wide, sitting either side of
          6 o'clock:

            left    228 -> 194     (14 to 48 degrees off the bottom)
            right   166 -> 132

          COUNTER_CLOCKWISE is what stands the glyphs upright along the
          bottom; CLOCKWISE hangs them upside down.

          A single 84-degree arc across the bottom read better, but it only
          worked because the string was ours. Once anyone can drop "Next
          event" into a slot, one long arc has nowhere to put the overflow.
          Two short arcs each hold a short value, and ellipsis="TRUE" clips
          what doesn't fit instead of running off the ends.

          The arcs stop 48 degrees off the bottom because a glyph standing
          perpendicular to the rim is also rotated by that angle, and past
          roughly 50 degrees the text is steep enough to be uncomfortable to
          read. That caps each arc near 110px, about 11 characters — which
          is fine, since SHORT_TEXT providers are meant to fit in seven.

          Coordinates inside a slot are relative to the slot's own x/y, so
          both slots span the full face and differ only in their BoundingArc,
          which is the tap target that launches the provider's app.

          supportedTypes deliberately omits the image types: this face is
          typographic, and an icon on a curved baseline looks like debris.
          EMPTY is included so a slot can be switched off entirely.
        -->
        <ComplicationSlot slotId="1" supportedTypes="SHORT_TEXT EMPTY"
                          x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT"
                                   defaultSystemProviderType="SHORT_TEXT" />
            <BoundingArc centerX="225" centerY="225" width="372" height="372"
                         thickness="46" startAngle="228" endAngle="194"
                         direction="COUNTER_CLOCKWISE" isRoundEdge="TRUE" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="450" height="450">
                    <TextCircular centerX="225" centerY="225"
                                  width="372" height="372"
                                  startAngle="228" endAngle="194"
                                  direction="COUNTER_CLOCKWISE"
                                  align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="15" color="#8A93A0">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </TextCircular>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot slotId="2" supportedTypes="SHORT_TEXT EMPTY"
                          x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy defaultSystemProvider="WATCH_BATTERY"
                                   defaultSystemProviderType="SHORT_TEXT" />
            <BoundingArc centerX="225" centerY="225" width="372" height="372"
                         thickness="46" startAngle="166" endAngle="132"
                         direction="COUNTER_CLOCKWISE" isRoundEdge="TRUE" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="450" height="450">
                    <TextCircular centerX="225" centerY="225"
                                  width="372" height="372"
                                  startAngle="166" endAngle="132"
                                  direction="COUNTER_CLOCKWISE"
                                  align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="15" color="#8A93A0">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </TextCircular>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- Marker in the gap at 6 o'clock, holding the two arcs apart. -->
        <PartDraw name="slot_divider" x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Ellipse x="222" y="408" width="6" height="6">
                <Fill color="#FF6E7783" />
            </Ellipse>
        </PartDraw>

    </Scene>
</WatchFace>
